# Copy to deploy/local.env (git-ignored) for docker-compose.local.yml. Only for your own machine.

# Required. Any value of your own; letters and digits only (it goes into a connection string).
MYSQL_PASSWORD=REPLACE_ME
# Required. At least 32 random characters, e.g. `openssl rand -base64 48` in Git Bash.
Jwt__SigningKey=REPLACE_ME

# Optional, like appsettings.Development.json: without a key the app still starts and only that
# feature fails when called. Without Email__Host the OTP codes are written to `docker compose logs api`.
MapVina__ApiKey=
Cloudinary__CloudName=
Cloudinary__ApiKey=
Cloudinary__ApiSecret=
PayOS__ClientId=
PayOS__ApiKey=
PayOS__ChecksumKey=
PayOS__ReturnUrls__Web=http://localhost:8080/orders/success
PayOS__CancelUrls__Web=http://localhost:8080/orders/cancel
Email__Host=
Email__UserName=
Email__Password=
