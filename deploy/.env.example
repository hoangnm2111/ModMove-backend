# Copy to /opt/modmove/.env on the VPS (chmod 600). Read by docker compose itself.
# Passwords: letters and digits only (they go into a connection string), e.g. `openssl rand -hex 24`.

DOMAIN=modmove.example.vn
MYSQL_PASSWORD=REPLACE_ME
MYSQL_ROOT_PASSWORD=REPLACE_ME

# Image tags. `latest` is what CD pushed last; set sha-<7 chars> to roll back (see deploy/README.md).
API_TAG=latest
WEB_TAG=latest
