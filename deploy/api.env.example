# Copy to /opt/modmove/api.env on the VPS (chmod 600). Environment variables for the API container:
# `__` stands for `:` in appsettings keys. Use new production values, never the ones from a developer machine.
# The app refuses to start in Production while a required key below is empty (ProductionConfiguration.cs).

# Required. At least 32 random characters: `openssl rand -base64 48`
Jwt__SigningKey=REPLACE_ME

# Required: maps (fare estimate, booking, tracking ETA)
MapVina__ApiKey=REPLACE_ME

# Required: image uploads
Cloudinary__CloudName=REPLACE_ME
Cloudinary__ApiKey=REPLACE_ME
Cloudinary__ApiSecret=REPLACE_ME
Cloudinary__UploadPreset=modmove

# Required: PayOS production channel. Its webhook URL is https://<DOMAIN>/api/webhooks/payos
PayOS__ClientId=REPLACE_ME
PayOS__ApiKey=REPLACE_ME
PayOS__ChecksumKey=REPLACE_ME
PayOS__ReturnUrls__App=modmove://orders
PayOS__CancelUrls__App=modmove://orders

# Required: SMTP for OTP and notification emails
Email__Host=REPLACE_ME
Email__Port=587
Email__UserName=REPLACE_ME
Email__Password=REPLACE_ME
# Optional: without it the sender is Email__UserName (leave the line commented, an empty value is used as is)
# Email__FromAddress=
Email__FromName=ModMove

# First Administrator, created on the first start while no Administrator exists.
# Remove Seed__Admin__Password after the first start and sign in to change it.
Seed__Admin__FullName=Administrator
Seed__Admin__Email=REPLACE_ME
Seed__Admin__PhoneNumber=REPLACE_ME
Seed__Admin__Password=REPLACE_ME

# Optional until the mobile app ships: push notifications (without them pushes are only logged).
# Firebase__ProjectId=
# Firebase__ClientEmail=
# Firebase__PrivateKey=
